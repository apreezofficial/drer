{
  "name": "drer-desktop",
  "version": "0.2.0",
  "description": "DRER \u2014 cross-platform desktop assistant",
  "author": "Precious Adedokun <hello@preciousadedokun.com.ng>",
  "homepage": "https://auraos.com",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --show",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:mac": "npm run build:native && electron-builder --mac --arm64 --config.electronDist=node_modules/electron/dist",
    "build:linux": "electron-builder --linux",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node scripts/native-system-test.cjs",
    "build:native": "node scripts/build-native.cjs",
    "prestart": "node scripts/build-native.cjs",
    "pack:mac": "npm run build:native && electron-builder --mac --dir --arm64 --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "24.13.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.drer.desktop",
    "productName": "DRER",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "DRER reads a screen only when you request screen context.",
        "NSMicrophoneUsageDescription": "DRER uses the microphone when you start voice input.",
        "NSAppleEventsUsageDescription": "DRER controls apps such as Spotify only when you ask it to.",
        "NSRemindersFullAccessUsageDescription": "DRER creates native reminders and timed alerts you request.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "DRER adds events you request to Apple Calendar.",
        "LSUIElement": true
      },
      "identity": null,
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "native/build/**/*",
      "native/*.applescript",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "native/build/**/*",
      "native/*.applescript"
    ]
  },
  "productName": "DRER"
}
